# Backend provider credentials — copy to a local .env and fill values there.
DEEPGRAM_API_KEY=
GOOGLE_API_KEY=
CARTESIA_API_KEY=

# Local development
FRONTEND_ORIGIN=http://localhost:3000
# Number of audible assistant responses before bot audio is permanently
# dropped for the rest of the call (Gate D). 0 disables freeze injection.
FREEZE_AFTER_ASSISTANT_TURNS=2

# Optional overrides (defaults are set in server/config.py)
# GEMINI_MODEL=gemini-3.6-flash
# CARTESIA_VOICE_ID=86e30c1d-714b-4074-a1f2-1cb6b552fb49

# Frontend (non-secret; set in web/.env.local if backend is not on localhost:7860)
# NEXT_PUBLIC_TURNTRACE_API_URL=http://localhost:7860
